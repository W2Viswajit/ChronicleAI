# Copy to .env. Never commit your real key.
GEMINI_API_KEY=
# Choose a model available in your AI Studio project.
GEMINI_MODEL=gemini-2.5-flash
# Start in lightweight mode. Switch to models after setup-models.ps1.
NLP_MODE=lightweight
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_THRESHOLD=0.80
MAX_NLI_PAIRS=40
MAX_EVIDENCE_CHARS=24000
# Optional comma-separated publisher RSS feed URLs.
RSS_FEEDS=
